# Steinz Labs — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.
# Production values live in Vercel → Project Settings → Environment Variables.
#
# Convention:
#   NEXT_PUBLIC_* → exposed to the browser bundle. Anything in here is public.
#   Everything else → server-only. Read inside API routes / server components.

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nakalabs.xyz
NODE_ENV=development

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS — server-side only, never expose. Use getSupabaseAdmin().
SUPABASE_SERVICE_ROLE_KEY=
# Optional, only if a webhook from Supabase posts back to /api/webhooks/supabase
SUPABASE_WEBHOOK_SECRET=

# ─── Anthropic (Claude) ─────────────────────────────────────────────────────
# Used by VTX Agent. Sonnet for fast queries, Opus for advisor escalation.
ANTHROPIC_API_KEY=

# ─── Alchemy (EVM RPC + webhooks) ───────────────────────────────────────────
# Server-side key. Use this from API routes; never bundle the EVM RPC key
# into the client (NEXT_PUBLIC_ALCHEMY_API_KEY was deprecated for that reason).
ALCHEMY_API_KEY=
# Webhook signing keys — comma-separated list, one per chain webhook.
# Required in production; absence will cause /api/webhooks/alchemy-whale to
# fail closed with 401.
ALCHEMY_WEBHOOK_SIGNING_KEYS=
# Legacy single-key var, still honored for backwards compat.
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Local-only escape hatch for unsigned webhooks (set explicitly to "true").
# Ignored when NODE_ENV=production.
ALCHEMY_WEBHOOK_DEV_BYPASS=

# ─── Helius (Solana RPC + webhooks) ─────────────────────────────────────────
HELIUS_API_KEY=
# Custom Authorization header value configured on Helius webhook.
# Compared with crypto.timingSafeEqual.
HELIUS_WEBHOOK_SECRET=
HELIUS_WEBHOOK_DEV_BYPASS=

# ─── Other RPC fallbacks (optional) ─────────────────────────────────────────
NEXT_PUBLIC_ALCHEMY_RPC=

# ─── Robinhood Chain (no new key required) ──────────────────────────────────
# Robinhood Chain (Arbitrum-Orbit L2, native gas ETH, mainnet chain id 4663 /
# 0x1237) is a first-class EVM chain. It reuses the shared ALCHEMY_API_KEY
# above — Alchemy serves it at https://robinhood-mainnet.g.alchemy.com/v2/{key}.
# When ALCHEMY_API_KEY is unset, reads/sends fall back to the public RPC
# (https://rpc.mainnet.chain.robinhood.com) automatically; native ETH balance
# and send work on either. DEX/swap routing is NOT yet available (0x does not
# list the chain) — see DEX_SUPPORTED_CHAINS in lib/chains/evmRpc.ts. No new
# env var is needed for Robinhood Chain.

# ─── NakaCult entitlements (all optional — live mainnet defaults baked in) ───
# Cult membership: holding the NIPPO NFT OR >= NAKA_CULT_THRESHOLD $NAKA.
# Max platform tier: holding the Founder Pass NFT (6 months from first link).
NEXT_PUBLIC_NAKA_TOKEN_ADDRESS=0x6967b9a8c0b14849CFE8f9E5732B401433fD2898
NAKA_CULT_THRESHOLD=1227000
NIPPO_NFT_CONTRACT=0x69411ADa5CccF7bbfb19428462a7bB6c38BCb4Cb
FOUNDER_PASS_NFT_CONTRACT=0x14Ab8f5c26eBABD31A66b89dC38d2D21D5E01C67

# ─── 0x (EVM swap aggregator) ────────────────────────────────────────────────
ZX_API_KEY=
NEXT_PUBLIC_ZX_API_KEY=

# ─── Jupiter (Solana swap aggregator) ───────────────────────────────────────
# No key required for the public REST endpoints; left here for completeness
# in case a paid tier is enabled later.

# ─── CoinGecko ──────────────────────────────────────────────────────────────
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# ─── RWA / TradFi board (indices, stocks, gold/oil) ─────────────────────────
# Powers /api/markets/rwa + <RwaBoard>. Twelve Data (https://twelvedata.com)
# free tier serves quotes + a mini daily series for the sparkline, and covers
# US equities plus forex/commodity pairs (XAU/USD gold, WTI/USD oil). Without
# this key the API returns { available:false } and the board shows an honest
# "Live market data coming online" state — it never fabricates a price.
TWELVE_DATA_API_KEY=
# Optional alternative provider. Not wired up (Twelve Data is the active
# source); kept here so the owner can swap without hunting for the var name.
FINNHUB_API_KEY=

# ─── DexScreener / GoPlus ───────────────────────────────────────────────────
# GoPlus authenticates with an App Key + App Secret (both from the GoPlus
# dashboard). The server signs sha1(app_key + time + app_secret) to mint a
# short lived access token; only then do requests count against your plan and
# get the full rate limit. Without both, calls fall back to the throttled
# anonymous public tier (and show as 0 usage on the GoPlus dashboard).
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# Legacy single key — no longer used for auth. Safe to leave unset.
GOPLUS_API_KEY=
GOPLUS_TIMEOUT_MS=15000

# ─── Security suite (all OPTIONAL — features fall back to free-no-key sources
#     and never fabricate when these are unset) ────────────────────────────────
# Etherscan API V2: ONE key works across Ethereum/Base/Arbitrum/Polygon/BSC/
# Optimism via the chainid param. Get it at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# URLScan.io site verdict + screenshot. Key at https://urlscan.io/user/profile
URLSCAN_API_KEY=
# Google Safe Browsing v4. Key via Google Cloud Console (Safe Browsing API).
# NOTE: v4 is licensed non-commercial; commercial use is meant for Web Risk (paid).
GOOGLE_SAFE_BROWSING_KEY=
# Chainabuse (TRM Labs) community scam reports. Request at https://www.chainabuse.com/api
CHAINABUSE_API_KEY=

# ─── LunarCrush ─────────────────────────────────────────────────────────────
LUNARCRUSH_API_KEY=

# ─── Bitquery (cross-chain smart-money discovery — replaces Arkham) ──────────
# v2 EAP OAuth access token. Feeds the whale-discovery cron's Bitquery pass
# (top DEX buyers → whales). No-op until set. Verify the GraphQL in
# https://ide.bitquery.io for your plan before relying on it.
BITQUERY_API_KEY=
# Optional endpoint override (default https://streaming.bitquery.io/graphql)
BITQUERY_ENDPOINT=

# ─── Birdeye (Solana market data) ───────────────────────────────────────────
BIRDEYE_API_KEY=

# ─── Resend (transactional email) ───────────────────────────────────────────
RESEND_API_KEY=

# ─── Telegram bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Set to a long random string; Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# ─── Upstash Redis (rate limit + cache) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── PostHog (analytics) ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Minimum 32 random chars: openssl rand -base64 32
JWT_SECRET=
SUPABASE_JWT_SECRET=
# Static admin bearer for /admin/* layout access. Long random string.
ADMIN_BEARER_TOKEN=

# ─── Cloudflare Turnstile (CAPTCHA on auth flows) ───────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Reown AppKit / WalletConnect v2 ─────────────────────────────────────────
# Project ID from https://dashboard.reown.com — required for the EVM
# "Sign up / Sign in with wallet" buttons on /signup + /login and the
# AppKit connect modal on the swap page. When unset, the EVM wallet auth
# button hides (Phantom-only fallback) and legacy extension connects still
# work. The serving origin (apex + www + previews) must be allow-listed in
# the Reown dashboard or wallets fail the Verify handshake.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Vercel sets this automatically when calling /api/cron/*. Routes verify it.
CRON_SECRET=

# Trust Wallet API Gateway (free tier, 1 req/s) — create an app at
# https://portal.trustwallet.com → dashboard/apps → API key. The HMAC secret
# is shown ONCE at creation. Server-side only; never expose to the client.
# All Trust Wallet gateway calls are additive enrichment and no-op when unset.
TWAK_ACCESS_ID=
TWAK_HMAC_SECRET=

# Crypto-native tier payments — treasury address that receives USDC. Same
# address works across all EVM chains (Base/Arbitrum/Polygon/Ethereum). The
# payment-verify cron watches it via Alchemy and grants the tier on match.
# Payments are disabled (create route 503s) until this is set.
TREASURY_EVM_ADDRESS=

# ─── GoldRush (Covalent) — OPTIONAL multichain data provider ──────────────────
# Powers three things when set: (1) VTX agent GoldRush wallet tools
# (goldrush_wallet_balances / goldrush_wallet_transactions), (2) richer
# Robinhood Chain wallet data (token holdings + USD, vs raw-RPC native only),
# (3) the /api/market/ohlcv token OHLCV route. Get a free key at
# https://goldrush.dev — free tier is ~25k–100k credits/mo at ~4 req/s, plenty
# for the cached/timeout-bounded use here.
#
# EVERYTHING degrades gracefully when UNSET: the VTX tools return
# "goldrush_unconfigured" and the agent falls back to wallet_profile / RPC,
# Robinhood balances fall back to raw RPC (native ETH only), and /api/market/ohlcv
# returns an honest empty series. No fabricated balances/prices, ever.
#
# COVALENT_API_KEY is the canonical name; GOLDRUSH_API_KEY is an accepted alias.
COVALENT_API_KEY=
# GOLDRUSH_API_KEY=
# Optional: Robinhood Chain's GoldRush chainName slug. Robinhood's exact
# GoldRush slug was not verifiable at build time, so it is NOT hardcoded — set
# this to the real slug (once known) to enable the GoldRush path for Robinhood;
# until then Robinhood data uses raw RPC. Other chains
# (eth/base/bsc/arbitrum/optimism/polygon/avalanche/solana) are pre-mapped.
# GOLDRUSH_ROBINHOOD_CHAIN=
